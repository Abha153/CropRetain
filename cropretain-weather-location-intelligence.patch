+def test_rain_in_the_following_hours_blocks_the_hour_before_it():
+    def edit(h):
+        for r in h:
+            if r["time"] == "2026-10-19T16:00":
+                r["rainfall_mm"] = 1.0; r["rain_probability"] = 80
