@@ -0,0 +1,62 @@
+// Remembers the last location the user EXPLICITLY chose on the weather page
+// (picked from search results or via "Use My Location"), on this device only
+// (localStorage). Privacy: coordinates are rounded to 2 decimals (~1 km --
+// the same precision the weather provider is queried with), nothing is sent
+// anywhere from here, and nothing is stored until the user picks a place.
+
+const KEY = 'cropretain.weatherLocation.v1'
+const CROP_KEY = 'cropretain.weatherCrop.v1'
+
+export function roundCoord(n) {
+  return Math.round(Number(n) * 100) / 100
+}
+
+export function isValidLocation(loc) {
+  return !!loc && typeof loc === 'object'
+    && Number.isFinite(loc.latitude) && Number.isFinite(loc.longitude)
+    && Math.abs(loc.latitude) <= 90 && Math.abs(loc.longitude) <= 180
+    && typeof loc.label === 'string' && loc.label.length > 0
+}
+
+export function loadLocation(storage = globalThis.localStorage) {
+  try {
+    const raw = storage.getItem(KEY)
+    if (!raw) return null
+    const loc = JSON.parse(raw)
+    return isValidLocation(loc) ? loc : null
+  } catch (e) {
+    return null
+  }
+}
+
+export function saveLocation(loc, storage = globalThis.localStorage) {
+  if (!isValidLocation(loc)) return false
+  const safe = {
+    label: loc.label,
+    name: loc.name || loc.label,
+    admin1: loc.admin1 || null,
+    admin2: loc.admin2 || null,
+    country: loc.country || null,
+    latitude: roundCoord(loc.latitude),
+    longitude: roundCoord(loc.longitude),
+    source: loc.source === 'gps' ? 'gps' : 'search',
+  }
+  try { storage.setItem(KEY, JSON.stringify(safe)); return true } catch (e) { return false }
+}
+
+export function clearLocation(storage = globalThis.localStorage) {
+  try { storage.removeItem(KEY) } catch (e) { /* ignore */ }
+}
+
+export function loadCropChoice(storage = globalThis.localStorage) {
+  try {
+    const c = JSON.parse(storage.getItem(CROP_KEY) || 'null')
+    return c && typeof c === 'object' ? { crop: String(c.crop || ''), stage: String(c.stage || '') } : { crop: '', stage: '' }
+  } catch (e) {
+    return { crop: '', stage: '' }
+  }
+}
+
+export function saveCropChoice(choice, storage = globalThis.localStorage) {
+  try { storage.setItem(CROP_KEY, JSON.stringify({ crop: choice.crop || '', stage: choice.stage || '' })) } catch (e) { /* ignore */ }
+}
diff --git a/frontend/tests/weather-advisory-i18n.test.mjs b/frontend/tests/weather-advisory-i18n.test.mjs
new file mode 100644
index 0000000..e40ac69
--- /dev/null
+++ b/frontend/tests/weather-advisory-i18n.test.mjs
@@ -0,0 +1,96 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import {
+  localizeInsight,
+  localizeAdvisorySummary,
+  localizeEtc,
+  localizeEtcAssumptions,
+  localizeLimitations,
+} from '../src/utils/weatherAdvisoryI18n.js'
+
+const locales = ['en', 'hi', 'mr', 'bn', 'ta', 'te', 'gu', 'kn', 'ml', 'pa', 'or', 'as', 'ur', 'bho', 'mai']
+
+test('weather advisory localization exists for all 15 shipped languages', () => {
+  for (const code of locales) {
+    const result = localizeInsight({
+      id: 'heat',
+      level: 'high',
+      title: 'Heat stress',
+      message: 'English server text',
+      trigger: 'Highest forecast temperature: 38°C on Mon 26 Oct.',
+      basis: 'English server basis',
+    }, code)
+    assert.ok(result.title, `missing title for ${code}`)
+    assert.ok(result.message.includes('38'), `weather measurement lost for ${code}`)
+    assert.ok(result.trigger, `missing trigger for ${code}`)
+    assert.ok(result.basis, `missing basis for ${code}`)
+    assert.notEqual(result.message, 'English server text', `server English leaked for ${code}`)
+  }
+})
+
+test('advisory summary reflects localized forecast risk', () => {
+  for (const code of locales) {
+    const summary = localizeAdvisorySummary(code, {
+      insights: [{
+        id: 'heat', level: 'high', title: 'Heat stress',
+        message: 'English server text', trigger: 'Highest forecast temperature: 38°C.',
+      }],
+    })
+    assert.ok(summary.includes('38'), `summary omitted forecast value for ${code}`)
+    assert.notEqual(summary, 'No weather risks stand out in the next 7 days.', code)
+  }
+})
+
+test('ETc and limitations are localized and retain calculation values', () => {
+  const etc = { crop: 'Wheat', stage: 'mid', kc: 1.15, days: 7, etc_mm: 23.4 }
+  for (const code of locales) {
+    const text = localizeEtc(etc, 'Wheat', 'Mid-season', code)
+    assert.ok(text.includes('23.4'), `ETc value missing for ${code}`)
+    assert.ok(text.includes('7'), `ETc duration missing for ${code}`)
+    assert.ok(localizeEtcAssumptions(code).length >= 3, `ETc assumptions missing for ${code}`)
+    const limitations = localizeLimitations(['This advice uses demonstration data.'], code)
+    assert.ok(limitations.length >= 3, `limitations missing for ${code}`)
+  }
+})
+
+test('every supported locale ships the complete weather-page translation key set', () => {
+  const base = new URL('../src/i18n/translations/', import.meta.url)
+  const english = JSON.parse(readFileSync(new URL('en.json', base), 'utf8'))
+  const keys = Object.keys(english).filter((key) => key.startsWith('weatherPage.'))
+  assert.ok(keys.length > 0)
+  for (const code of locales) {
+    const translations = JSON.parse(readFileSync(new URL(`${code}.json`, base), 'utf8'))
+    for (const key of keys) {
+      assert.ok(Object.prototype.hasOwnProperty.call(translations, key), `${code} missing ${key}`)
+      assert.equal(typeof translations[key], 'string', `${code} has invalid value for ${key}`)
+      assert.ok(translations[key].trim(), `${code} has empty value for ${key}`)
+    }
+  }
+})
+
+test('every advisory type has localized title, message, and trigger in every language', () => {
+  const samples = [
+    { id: 'heat', level: 'high', trigger: 'Highest forecast temperature: 38°C on 2026-10-26.', when: '2026-10-26' },
+    { id: 'cold', level: 'moderate', trigger: 'Lowest forecast temperature: 4°C on 2026-10-26.', when: '2026-10-26' },
+    { id: 'wind', level: 'moderate', trigger: 'Peak forecast gusts: 45 km/h on 2026-10-26.', when: '2026-10-26' },
+    { id: 'heavy_rain', level: 'high', trigger: 'Largest 24 h forecast: 70 mm (heavy) on 2026-10-26.', when: '2026-10-26' },
+    { id: 'rain_outlook', level: 'info', trigger: 'Forecast rain: 4 mm in 3 days, 12 mm in 7 days.' },
+    { id: 'et0', level: 'info', trigger: 'ET₀ 4 mm/day average, 28 mm total over 7 days.' },
+    { id: 'harvest_window', level: 'info', trigger: '3 consecutive dry days.', window: { days: 3 } },
+    { id: 'sowing_window', level: 'info', trigger: '5 of 7 days suitable.', window: { days: ['a', 'b', 'c', 'd', 'e'] } },
+    { id: 'spray_window', level: 'info', trigger: '1 suitable window found.', windows: [{ start: '2026-10-26T09:00' }] },
+  ]
+  for (const code of locales) {
+    for (const sample of samples) {
+      const localized = localizeInsight({ ...sample, title: 'English title', message: 'English message' }, code)
+      assert.ok(localized.title, `${code} missing title for ${sample.id}`)
+      assert.ok(localized.message, `${code} missing message for ${sample.id}`)
+      assert.ok(localized.trigger, `${code} missing trigger for ${sample.id}`)
+      assert.ok(localized.basis, `${code} missing basis for ${sample.id}`)
+      assert.notEqual(localized.basis, 'English server basis', `${code} has English basis for ${sample.id}`)
+      assert.notEqual(localized.title, 'English title', `${code} has English title for ${sample.id}`)
+      assert.notEqual(localized.message, 'English message', `${code} has English message for ${sample.id}`)
+    }
+  }
+})
diff --git a/frontend/tests/weather-utils.test.mjs b/frontend/tests/weather-utils.test.mjs
new file mode 100644
index 0000000..1b454eb
--- /dev/null
+++ b/frontend/tests/weather-utils.test.mjs
@@ -0,0 +1,133 @@
+// Run with: npm test   (Node's built-in runner; no extra dependencies)
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import {
+  requestBrowserPosition, stateForPositionError, GEO_STATES, getGeolocationPermission,
+} from '../src/utils/geolocation.js'
+import {
+  loadLocation, saveLocation, clearLocation, isValidLocation, loadCropChoice, saveCropChoice,
+} from '../src/utils/weatherLocationStore.js'
+import {
+  formatHour, formatClock, formatDayShort, formatDayLong, formatUpdatedAt, ageParts, compassDirection, locationLines,
+} from '../src/utils/weatherFormat.js'
+
+const navWith = (impl) => ({ geolocation: { getCurrentPosition: impl } })
+const memStorage = () => { const m = new Map(); return { getItem: (k) => m.get(k) ?? null, setItem: (k, v) => m.set(k, v), removeItem: (k) => m.delete(k) } }
+
+test('geolocation: success returns coordinates', async () => {
+  const nav = navWith((ok) => ok({ coords: { latitude: 21.25, longitude: 81.63, accuracy: 30 } }))
+  const r = await requestBrowserPosition({ nav, secureContext: true })
+  assert.deepEqual(r, { latitude: 21.25, longitude: 81.63, accuracyMeters: 30 })
+})
+
+test('geolocation: denied, timeout, unavailable map to distinct states', async () => {
+  for (const [code, state] of [[1, GEO_STATES.PERMISSION_DENIED], [3, GEO_STATES.TIMEOUT], [2, GEO_STATES.UNAVAILABLE]]) {
+    const nav = navWith((_, bad) => bad({ code, message: 'x' }))
+    await assert.rejects(requestBrowserPosition({ nav, secureContext: true }), (e) => e.state === state)
+    assert.equal(stateForPositionError({ code }), state)
+  }
+})
+
+test('geolocation: unsupported, insecure context and junk coordinates are rejected', async () => {
+  await assert.rejects(requestBrowserPosition({ nav: {}, secureContext: true }), (e) => e.state === GEO_STATES.UNSUPPORTED)
+  const nav = navWith(() => assert.fail('must not prompt on insecure context'))
+  await assert.rejects(requestBrowserPosition({ nav, secureContext: false }), (e) => e.state === GEO_STATES.INSECURE_CONTEXT)
+  const bad = navWith((ok) => ok({ coords: { latitude: 123, longitude: 10 } }))
+  await assert.rejects(requestBrowserPosition({ nav: bad, secureContext: true }), (e) => e.state === GEO_STATES.UNAVAILABLE)
+})
+
+test('geolocation: permission query degrades to null', async () => {
+  assert.equal(await getGeolocationPermission({}), null)
+  assert.equal(await getGeolocationPermission({ permissions: { query: async () => ({ state: 'denied' }) } }), 'denied')
+})
+
+test('location store: rounds coordinates, rejects invalid, survives corrupt data', () => {
+  const s = memStorage()
+  assert.equal(saveLocation({ label: 'Raipur, CG', latitude: 21.251384, longitude: 81.629641, source: 'gps' }, s), true)
+  const loc = loadLocation(s)
+  assert.equal(loc.latitude, 21.25); assert.equal(loc.longitude, 81.63); assert.equal(loc.source, 'gps')
+  assert.equal(saveLocation({ label: 'x', latitude: 95, longitude: 0 }, s), false)
+  assert.equal(isValidLocation({ label: '', latitude: 1, longitude: 1 }), false)
+  s.setItem('cropretain.weatherLocation.v1', '{not json')
+  assert.equal(loadLocation(s), null)
+  clearLocation(s); assert.equal(loadLocation(s), null)
+})
+
+test('crop choice round-trips and defaults safely', () => {
+  const s = memStorage()
+  assert.deepEqual(loadCropChoice(s), { crop: '', stage: '' })
+  saveCropChoice({ crop: 'wheat', stage: 'flowering' }, s)
+  assert.deepEqual(loadCropChoice(s), { crop: 'wheat', stage: 'flowering' })
+})
+
+test('format: location-local times are not shifted by the viewer timezone', () => {
+  assert.equal(formatHour('2026-10-19T00:00'), '12 AM')
+  assert.equal(formatHour('2026-10-19T13:00'), '1 PM')
+  assert.equal(formatClock('2026-10-19T05:07'), '05:07')
+  assert.equal(formatDayShort('2026-10-19'), 'Mon')
+  // 07:45 UTC at IST (+19800 s) is 13:15 local.
+  assert.match(formatUpdatedAt('2026-10-19T07:45:00Z', 19800), /19.*Oct.*13:15|Oct.*19.*13:15/)
+  assert.equal(formatUpdatedAt('garbage', 0), null)
+})
+
+test('format: calendar labels and clocks follow every supported locale without timezone shifting', () => {
+  const locales = ['en', 'hi', 'mr', 'bn', 'ta', 'te', 'gu', 'kn', 'ml', 'pa', 'or', 'as', 'ur', 'bho', 'mai']
+  for (const locale of locales) {
+    assert.ok(formatDayShort('2026-10-19', locale).length > 0, locale)
+    assert.ok(formatDayLong('2026-10-19', locale).length > 0, locale)
+    assert.ok(formatHour('2026-10-19T13:00', locale).length > 0, locale)
+    assert.ok(formatClock('2026-10-19T05:07', locale).length > 0, locale)
+    assert.ok(formatUpdatedAt('2026-10-19T07:45:00Z', 19800, locale).length > 0, locale)
+  }
+  assert.notEqual(formatDayShort('2026-10-19', 'en'), formatDayShort('2026-10-19', 'hi'))
+  assert.notEqual(formatDayLong('2026-10-19', 'en'), formatDayLong('2026-10-19', 'hi'))
+})
+
+test('format: age, compass and location lines', () => {
+  assert.deepEqual(ageParts(30), { unit: 'seconds', value: 30 })
+  assert.deepEqual(ageParts(600), { unit: 'minutes', value: 10 })
+  assert.deepEqual(ageParts(7200), { unit: 'hours', value: 2 })
+  assert.equal(ageParts(-1), null)
+  assert.equal(compassDirection(0), 'N'); assert.equal(compassDirection(359), 'N'); assert.equal(compassDirection(90), 'E')
+  assert.deepEqual(locationLines({ name: 'Bilaspur', admin2: 'Bilaspur', admin1: 'Chhattisgarh', country: 'India' }),
+    { title: 'Bilaspur', subtitle: 'Chhattisgarh, India' })
+})
+
+import { weatherConditionKey, iconForWeatherCode } from '../src/utils/weatherCodes.js'
+
+test('weather conditions: every supported WMO code has a localized translation key', () => {
+  const cases = [
+    [0, 'clear'], [1, 'mainlyClear'], [2, 'partlyCloudy'], [3, 'overcast'],
+    [45, 'fog'], [48, 'fog'], [51, 'drizzle'], [55, 'drizzle'],
+    [56, 'freezingDrizzle'], [57, 'freezingDrizzle'], [61, 'rain'], [65, 'rain'],
+    [66, 'freezingRain'], [67, 'freezingRain'], [71, 'snow'], [77, 'snow'],
+    [80, 'showers'], [82, 'showers'], [85, 'snowShowers'], [86, 'snowShowers'],
+    [95, 'thunderstorm'], [96, 'thunderstorm'], [99, 'thunderstorm'], [999, 'unknown'],
+  ]
+  for (const [code, suffix] of cases) {
+    assert.equal(weatherConditionKey(code), `weatherPage.condition.${suffix}`)
+    assert.ok(iconForWeatherCode(code))
+  }
+})
+
+
+test('weather localization: all 15 locales include every weather key and preserve interpolation placeholders', async () => {
+  const locales = ['en', 'hi', 'mr', 'bn', 'ta', 'te', 'gu', 'kn', 'ml', 'pa', 'or', 'as', 'ur', 'bho', 'mai']
+  const dictionaries = Object.fromEntries(locales.map((locale) => [
+    locale,
+    JSON.parse(readFileSync(new URL(`../src/i18n/translations/${locale}.json`, import.meta.url), 'utf8')),
+  ]))
+  const reference = dictionaries.en
+  const weatherKeys = Object.keys(reference).filter((key) => key.startsWith('weatherPage.'))
+  const placeholders = (value) => [...String(value).matchAll(/{{\s*([^}\s]+)\s*}}/g)].map((match) => match[1]).sort()
+  assert.ok(weatherKeys.length > 0, 'English weather translation keys should exist')
+  for (const locale of locales) {
+    for (const key of weatherKeys) {
+      assert.ok(Object.hasOwn(dictionaries[locale], key), `${locale} is missing ${key}`)
+      assert.deepEqual(placeholders(dictionaries[locale][key]), placeholders(reference[key]), `${locale} has different placeholders for ${key}`)
+      assert.equal(typeof dictionaries[locale][key], 'string', `${locale} value for ${key} must be text`)
+      assert.ok(dictionaries[locale][key].trim().length > 0, `${locale} value for ${key} must not be empty`)
+    }
+  }
+})
