+
+const LEVEL_KEYS = { low: 'weatherPage.risk.low', moderate: 'weatherPage.risk.moderate', high: 'weatherPage.risk.high', info: 'weatherPage.risk.info' };
+
+function numbers(text) {
+  return (String(text || '').match(/[-+]?\d+(?:\.\d+)?/g) || []).map(Number);
+}
+
+function formatNumber(n) {
+  return Number.isFinite(n) ? String(Number(n.toFixed(1))) : '—';
+}
+
+export function localizeInsight(item, code = 'en') {
+  const c = COPY[code] || COPY.en;
+  const index = IDS.indexOf(item?.id);
+  if (index < 0) return {
+    ...item,
+    title: item?.title || '',
+    message: item?.message || '',
+    trigger: (TRIGGERS[code] || TRIGGERS.en)[index].replace('{v}', formatNumber(value)) + (item.when ? ' · ' + formatDayLong(item.when, code) : ''),
+    basis: (BASIS_COPY[code] || BASIS_COPY.en)[({ heat: 0, cold: 0, wind: 1, heavy_rain: 2, rain_outlook: 2, et0: 3, harvest_window: 4, sowing_window: 4, spray_window: 4 })[item.id]],
+  };
+  const ns = numbers(item.trigger);
+  let value = ns[0];
+  if (item.id === 'rain_outlook') value = ns.length >= 2 ? ns[1] : ns[0];
+  if (item.id === 'et0') value = ns[0];
+  if (item.id === 'harvest_window') value = item.window?.days ?? ns[0] ?? 0;
+  if (item.id === 'sowing_window') value = Array.isArray(item.window?.days) ? item.window.days.length : 0;
+  if (item.id === 'spray_window') value = Array.isArray(item.windows) ? item.windows.length : 0;
+  return {
+    ...item,
+    title: c.titles[index],
+    message: c.messages[index].replace('{v}', formatNumber(value)),
+    trigger: c.trigger,
+    basis: c.basis,
+  };
+}
+
+export function localizeAdvisorySummary(code = 'en', advisory = null) {
+  const c = COPY[code] || COPY.en;
+  const insights = advisory?.insights || [];
+  const flagged = insights
+    .filter((item) => item.level === 'high' || item.level === 'moderate')
+    .slice(0, 2)
+    .map((item) => localizeInsight(item, code).message);
+  if (flagged.length) return flagged.join(' ');
+  const rain = insights.find((item) => item.id === 'rain_outlook');
+  if (rain) return localizeInsight(rain, code).message;
+  return c.summary;
+}
+
+export function localizeEtc(etc, cropLabel, stageLabel, code = 'en') {
+  const c = COPY[code] || COPY.en;
+  if (!etc) return null;
+  return c.etc
+    .replace('{crop}', cropLabel || etc.crop || '')
+    .replace('{stage}', stageLabel || etc.stage || '')
+    .replace('{days}', String(etc.days))
+    .replace('{mm}', formatNumber(etc.etc_mm))
+    .replace('{kc}', String(etc.kc));
+}
+
+export function localizeEtcAssumptions(code = 'en') {
+  return (COPY[code] || COPY.en).assumptions;
+}
+
+export function localizeLimitations(limitations, code = 'en') {
+  const c = COPY[code] || COPY.en;
+  const result = [];
+  if (limitations?.some((x) => /demonstration data/i.test(x))) result.push(c.demo);
+  if (limitations?.some((x) => /saved forecast/i.test(x))) result.push(c.stale);
+  result.push(c.generalLimit, c.officialLimit);
+  return result;
+}
