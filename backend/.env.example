# CropRetain backend configuration
# Copy this file to .env for local development. Set production values
# independently in the cropretain-api Render service.

# Generate a unique secret for CropRetain. Do not reuse another project's key.
SECRET_KEY=replace-with-a-unique-random-secret

# Set to "production" on every real deployment. In production the app does
# NOT seed demo data at startup and refuses to create demo accounts.
APP_ENV=development

# Only for the opt-in demo accounts: `python -m app.demo_accounts`.
# 12+ characters of your own choosing. Never commit a real value.
# DEMO_ACCOUNT_PASSWORD=

# Access token lifetime, in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Local PostgreSQL connection. For production, use the Internal Database
# URL from the separate cropretain-db Render PostgreSQL service.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/<database>

# Local-development origins only. In Render, replace these with the actual
# CropRetain Vercel production origin(s); do not add CropWise origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production: with APP_ENV=production, admin login is DISABLED
# until both are set to values other than the documented demo defaults.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Live government mandi-price data. As of the multi-source update, two
# INDEPENDENT sources are queried CONCURRENTLY whenever both are
# configured -- data.gov.in and Agmarknet-via-CEDA -- and their results
# combined with source attribution (never one silently overriding the
# other; see app/services/mandi_directory.py::fetch_price_result for the
# full contract). Each source is entirely optional and independent: set
# either, both, or neither. With neither set, CropRetain runs entirely on
# the seeded demo dataset (clearly labeled as such).
#
# Source 1: data.gov.in ("Current Daily Price of Various Commodities from
# Various Markets" API, Agmarknet-sourced). Get your own free key at
# https://data.gov.in/user/register then https://data.gov.in/user/myapikeys.
# Set MARKET_DATA_SOURCE=live to require validated data.gov.in responses.
# In live mode, a missing key, timeout, invalid response, or empty result is
# reported as unavailable; seeded demo prices are never substituted silently.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_DISTRICT_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
MARKET_DATA_SOURCE=demo

# Source 2: Agmarknet, accessed via CEDA's AGMARKNET API (an aggregator
# that re-serves official Agmarknet mandi data through a documented REST
# API -- CropRetain has no separate/direct Agmarknet API integration, so
# there is intentionally only ONE key for this source, not a second
# "AGMARKNET_API_KEY"; CEDA_API_KEY IS the Agmarknet configuration).
CEDA_API_KEY=
