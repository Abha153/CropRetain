@@ -0,0 +1,131 @@
+import React from 'react'
+
+/**
+ * Soil-type picker for the Soil Advisor: visual cards instead of a dropdown.
+ *
+ * Honesty notes:
+ *  - The hand-test wording (ribbon length, gritty / smooth, sticky when wet)
+ *    comes from the backend's TEXTURE_GUIDE via GET /soil/options, where each
+ *    class carries its source ids (FAO ribbon exercise, Kansas State note).
+ *    Nothing agronomic is hard-coded here.
+ *  - The pictures are schematic sketches of mixed particle sizes, NOT photos
+ *    and not lab results; the card says so and the hand test decides.
+ *  - "Not sure" is a first-class choice: it sends no texture, so the
+ *    texture check is simply skipped.
+ *
+ * Accessibility: native radio inputs in one group (arrow keys work), a
+ * visible focus ring, and illustrations are aria-hidden.
+ */
+
+// Schematic particle mix per class: [sand, silt, clay] dot counts. These only
+// drive the sketch (bigger dots = coarser particles); they are not data.
+const MIX = {
+  sandy: [14, 3, 2],
+  sandy_loam: [10, 6, 5],
+  loam: [6, 8, 8],
+  silty_clay_loam: [2, 9, 12],
+  clay_loam: [4, 6, 14],
+  sandy_clay: [8, 3, 16],
+  clay: [1, 3, 26],
+}
+const RADII = [3.4, 1.8, 0.9]
+
+// Tiny seeded generator so each sketch is stable between renders.
+function dotsFor(cls) {
+  const [sand, silt, clay] = MIX[cls] || [0, 0, 0]
+  let seed = Array.from(cls).reduce((a, c) => a + c.charCodeAt(0), 7)
+  const rand = () => {
+    seed = (seed * 9301 + 49297) % 233280
+    return seed / 233280
+  }
+  const out = []
+  ;[sand, silt, clay].forEach((n, size) => {
+    for (let i = 0; i < n; i += 1) {
+      out.push({ x: 6 + rand() * 48, y: 6 + rand() * 48, r: RADII[size] })
+    }
+  })
+  return out
+}
+
+function Sketch({ cls }) {
+  return (
+    <svg viewBox="0 0 60 60" className="w-full h-16 rounded-lg bg-sand-50 dark:bg-white/10 text-marigold-dark dark:text-marigold-light" aria-hidden="true" focusable="false">
+      {dotsFor(cls).map((d, i) => (
+        <circle key={i} cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r={d.r} fill="currentColor" opacity="0.75" />
+      ))}
+    </svg>
+  )
+}
+
+function Card({ value, checked, onChange, children, name }) {
+  return (
+    <label className="relative block cursor-pointer">
+      <input type="radio" name={name} value={value} checked={checked}
+        onChange={() => onChange(value)} className="peer sr-only" />
+      <div className="h-full rounded-xl border border-black/10 dark:border-white/15 bg-white dark:bg-white/5 p-3 text-left transition
+        hover:border-forest/50 peer-checked:border-forest peer-checked:ring-2 peer-checked:ring-forest
+        peer-focus-visible:ring-2 peer-focus-visible:ring-marigold">
+        {children}
+      </div>
+    </label>
+  )
+}
+
+export default function SoilTexturePicker({ value, onChange, options, t }) {
+  const classes = options?.soil_texture || []
+  const guide = options?.texture_guide || {}
+  const sources = options?.texture_guide_sources || []
+  const name = 'soil-texture'
+
+  return (
+    <fieldset className="mb-2">
+      <legend className="text-xs font-semibold text-ink/60 dark:text-paper/60 mb-2">{t('soil.picker.legend')}</legend>
+
+      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
+        {classes.map(cls => {
+          const g = guide[cls]
+          return (
+            <Card key={cls} name={name} value={cls} checked={value === cls} onChange={onChange}>
+              <Sketch cls={cls} />
+              <span className="block mt-2 text-sm font-semibold">{t(`soil.texture.${cls}`)}</span>
+              {g && (
+                <ul className="mt-1 space-y-0.5 text-xs text-ink/70 dark:text-paper/70">
+                  <li>{t(`soil.guide.ribbon.${g.ribbon}`)}</li>
+                  {g.feel && <li>{t(`soil.guide.feel.${g.feel}`)}</li>}
+                  {g.sticky_when_wet && <li>{t('soil.guide.sticky')}</li>}
+                </ul>
+              )}
+            </Card>
+          )
+        })}
+        <Card name={name} value="" checked={value === ''} onChange={onChange}>
+          <div className="w-full h-16 rounded-lg bg-mist dark:bg-white/10 flex items-center justify-center text-2xl" aria-hidden="true">?</div>
+          <span className="block mt-2 text-sm font-semibold">{t('soil.picker.unsure')}</span>
+          <span className="block mt-1 text-xs text-ink/70 dark:text-paper/70">{t('soil.picker.unsureDesc')}</span>
+        </Card>
+      </div>
+
+      <p className="mt-2 text-xs text-ink/60 dark:text-paper/60">{t('soil.picker.illustration')}</p>
+
+      <details className="mt-2 text-xs">
+        <summary className="cursor-pointer font-semibold text-forest dark:text-forest-light">{t('soil.picker.howTitle')}</summary>
+        <ol className="mt-2 list-decimal list-inside space-y-1 text-ink/70 dark:text-paper/70">
+          <li>{t('soil.picker.how1')}</li>
+          <li>{t('soil.picker.how2')}</li>
+          <li>{t('soil.picker.how3')}</li>
+        </ol>
+        <p className="mt-2 text-ink/60 dark:text-paper/60">{t('soil.picker.limits')}</p>
+        {sources.length > 0 && (
+          <ul className="mt-2 space-y-1">
+            {sources.map(s => (
+              <li key={s.id}>
+                <a href={s.url} target="_blank" rel="noopener noreferrer" className="underline text-forest dark:text-forest-light">{s.title}</a>
+                <span className="text-ink/60 dark:text-paper/60"> — {s.publisher}</span>
+              </li>
+            ))}
+          </ul>
+        )}
+      </details>
+    </fieldset>
+  )
+}
