@@ -0,0 +1,227 @@
+"""
+Endpoint tests for partner reputation / QoS: who may record what, the
+"only after pickup" guard, duplicate protection, right-of-reply disputes,
+admin decisions, and the link to the negotiation agreement.
+
+Real JWTs, in-memory SQLite. Run: pytest backend/tests/test_reputation_router.py -v
+"""
+import datetime as dt
+import os
+import sys
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app import models
+from app.auth_utils import create_access_token
+from app.config import settings
+from app.database import Base, get_db
+from app.routers import reputation as rep_router
+from app.routers import transactions as txn_router
+from app.services import offer_negotiation as svc
+
+
+def tok(sub, role):
+    return {"Authorization": f"Bearer {create_access_token(sub, role)}"}
+
+
+@pytest.fixture()
+def d():
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False}, poolclass=StaticPool)
+    Base.metadata.create_all(bind=engine)
+    Maker = sessionmaker(bind=engine)
+    app = FastAPI()
+    app.include_router(rep_router.router)
+    app.include_router(txn_router.router)
+
+    def _db():
+        s = Maker()
+        try:
+            yield s
+        finally:
+            s.close()
+    app.dependency_overrides[get_db] = _db
+    db = Maker()
+    f = models.Farmer(name="F", email="f@x.in", password_hash="x", location="Bilaspur")
+    f2 = models.Farmer(name="F2", email="f2@x.in", password_hash="x", location="Bilaspur")
+    b = models.Buyer(company_name="B", email="b@x.in", password_hash="x", location="Raipur")
+    b2 = models.Buyer(company_name="B2", email="b2@x.in", password_hash="x", location="Raipur")
+    t = models.Transporter(name="T", email="t@x.in", password_hash="x", business_name="T Logistics")
+    t2 = models.Transporter(name="T2", email="t2@x.in", password_hash="x")
+    db.add_all([f, f2, b, b2, t, t2]); db.flush()
+    txn = models.Transaction(farmer_id=f.id, buyer_id=b.id, final_price_per_kg=20, quantity_kg=100,
+                             total_amount=2000, status="PICKED_UP")
+    early = models.Transaction(farmer_id=f.id, buyer_id=b.id, final_price_per_kg=20, quantity_kg=100,
+                               total_amount=2000, status="OFFER_ACCEPTED")
+    trip = models.TransportRequest(farmer_id=f.id, transporter_id=t.id, pickup_location="A", destination="B",
+                                   status="DELIVERED", transporter_agreed_price=1000)
+    pending_trip = models.TransportRequest(farmer_id=f.id, transporter_id=t.id, pickup_location="A",
+                                           destination="B", status="CONFIRMED")
+    db.add_all([txn, early, trip, pending_trip]); db.commit()
+    yield {"c": TestClient(app), "db": db, "f": f, "b": b, "t": t, "txn": txn, "early": early,
+           "trip": trip, "pending_trip": pending_trip,
+           "fh": tok(f.email, "farmer"), "f2h": tok(f2.email, "farmer"), "bh": tok(b.email, "buyer"),
+           "b2h": tok(b2.email, "buyer"), "th": tok(t.email, "transporter"), "t2h": tok(t2.email, "transporter"),
+           "ah": tok(settings.admin_username, "admin")}
+    db.close()
+
+
+def record(d, headers, **kw):
+    body = {"transaction_id": d["txn"].id, "metric": "BUYER_PICKUP", "result": "ON_TIME", **kw}
+    return d["c"].post("/reputation/records", json=body, headers=headers)
+
+
+# ── recording buyer outcomes ─────────────────────────────────────────────────
+def test_farmer_records_outcome_and_buyer_is_notified_and_event_logged(d):
+    r = record(d, d["fh"])
+    assert r.status_code == 201, r.text
+    db = d["db"]
+    assert db.query(models.PerformanceRecord).one().subject_id == d["b"].id
+    assert "PERFORMANCE_RECORDED" in [e.event_type for e in db.query(models.TransactionEvent).all()]
+    n = db.query(models.Notification).filter_by(buyer_id=d["b"].id).one()
+    assert n.type == "reputation_outcome_recorded"
+
+
+@pytest.mark.parametrize("who", ["bh", "th", "ah"])
+def test_only_a_farmer_can_record(d, who):
+    assert record(d, d[who]).status_code == 403
+    assert d["c"].post("/reputation/records", json={}).status_code == 401
+
+
+def test_farmer_cannot_record_on_someone_elses_transaction(d):
+    assert record(d, d["f2h"]).status_code == 404        # not their transaction: no existence leak
+
+
+def test_outcome_rejected_before_pickup(d):
+    r = record(d, d["fh"], transaction_id=d["early"].id)
+    assert r.status_code == 400 and "picked up" in r.json()["detail"]
+    assert d["db"].query(models.PerformanceRecord).count() == 0
+
+
+@pytest.mark.parametrize("metric,result", [("BUYER_PICKUP", "AS_AGREED"), ("BUYER_TERMS", "LATE"),
+                                           ("NOPE", "ON_TIME"), ("BUYER_PICKUP", "perfect")])
+def test_metric_and_result_must_be_valid_together(d, metric, result):
+    assert record(d, d["fh"], metric=metric, result=result).status_code == 400
+
+
+def test_duplicate_outcome_is_409_but_other_metric_is_fine(d):
+    assert record(d, d["fh"]).status_code == 201
+    assert record(d, d["fh"], result="LATE").status_code == 409
+    assert record(d, d["fh"], metric="BUYER_TERMS", result="AS_AGREED").status_code == 201
+
+
+def test_outcome_event_and_evidence_reference_the_agreement_fingerprint(d):
+    db = d["db"]
+    offer = models.BuyerOffer(buyer_id=d["b"].id, offered_price_per_kg=20, quantity_kg=100, status="accepted")
+    db.add(offer); db.flush()
+    rnd = models.BuyerOfferRound(offer_id=offer.id, sequence=1, sender_role="buyer", sender_id=d["b"].id,
+                                 receiver_role="farmer", receiver_id=d["f"].id, price_per_kg=20,
+                                 quantity_kg=100, status="ACCEPTED", quality_grade="A")
+    db.add(rnd); db.flush()
+    terms = svc.agreement_terms(offer, rnd)
+    h = svc.terms_fingerprint(terms)
+    db.add(models.OfferAgreement(offer_id=offer.id, transaction_id=d["txn"].id, round_id=rnd.id,
+                                 farmer_id=d["f"].id, buyer_id=d["b"].id, accepted_by="farmer",
+                                 terms=terms, terms_hash=h, rounds_count=1))
+    d["txn"].offer_id = offer.id
+    db.commit()
+    assert record(d, d["fh"], metric="BUYER_TERMS", result="DEVIATED").status_code == 201
+    ev = [e for e in db.query(models.TransactionEvent).all() if e.event_type == "PERFORMANCE_RECORDED"][0]
+    assert h[:12] in ev.description
+    item = d["c"].get("/reputation/me/evidence", headers=d["bh"]).json()["items"][0]
+    assert item["agreement"]["terms_hash"] == h and item["agreement"]["terms"]["quality_grade"] == "A"
+
+
+# ── transport evidence ───────────────────────────────────────────────────────
+def test_final_charge_only_after_delivery_by_the_trips_farmer_and_only_once(d):
+    url = lambda r: f"/reputation/transport/{r.id}/final-charge"
+    assert d["c"].post(url(d["pending_trip"]), json={"final_charge": 900}, headers=d["fh"]).status_code == 400
+    assert d["c"].post(url(d["trip"]), json={"final_charge": 900}, headers=d["f2h"]).status_code == 404
+    assert d["c"].post(url(d["trip"]), json={"final_charge": 900}, headers=d["th"]).status_code == 403
+    assert d["c"].post(url(d["trip"]), json={"final_charge": 0}, headers=d["fh"]).status_code == 422
+    assert d["c"].post(url(d["trip"]), json={"final_charge": 1100}, headers=d["fh"]).status_code == 200
+    assert d["c"].post(url(d["trip"]), json={"final_charge": 1200}, headers=d["fh"]).status_code == 409
+    d["db"].expire_all()
+    assert d["db"].get(models.TransportRequest, d["trip"].id).final_charge == 1100
+
+
+def test_delivery_promise_rules(d):
+    url = lambda r: f"/reputation/transport/{r.id}/delivery-promise"
+    body = {"promised_delivery_by": "2026-11-10"}
+    assert d["c"].post(url(d["pending_trip"]), json={"promised_delivery_by": "10/11/2026"}, headers=d["fh"]).status_code == 400
+    assert d["c"].post(url(d["trip"]), json=body, headers=d["fh"]).status_code == 400          # already delivered
+    assert d["c"].post(url(d["pending_trip"]), json=body, headers=d["t2h"]).status_code == 404  # unrelated agency
+    assert d["c"].post(url(d["pending_trip"]), json=body, headers=d["th"]).status_code == 200   # the trip's agency
+    assert d["c"].post(url(d["pending_trip"]), json=body, headers=d["fh"]).status_code == 409   # set once
+
+
+# ── disputes (right of reply) ────────────────────────────────────────────────
+REASON = "The truck was at the gate on time and waited."
+
+
+def test_buyer_can_contest_own_record_and_it_leaves_their_rates(d):
+    record(d, d["fh"], result="NO_SHOW")
+    rid = d["db"].query(models.PerformanceRecord).one().id
+    r = d["c"].post("/reputation/disputes", json={"target_type": "PERFORMANCE_RECORD", "target_id": rid,
+                                                  "reason": REASON}, headers=d["bh"])
+    assert r.status_code == 201 and r.json()["status"] == "OPEN"
+    prof = d["c"].get(f"/reputation/buyers/{d['b'].id}", headers=d["bh"]).json()
+    pk = {i["key"]: i for i in prof["indicators"]}["pickup_reliability"]
+    assert pk["status"] == "not_recorded" and pk["excluded_under_review"] == 1
+    assert d["c"].post("/reputation/disputes", json={"target_type": "PERFORMANCE_RECORD", "target_id": rid,
+                                                     "reason": REASON}, headers=d["bh"]).status_code == 409
+
+
+def test_cannot_contest_someone_elses_evidence_or_with_wrong_role(d):
+    record(d, d["fh"])
