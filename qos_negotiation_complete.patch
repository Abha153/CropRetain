+
+// One-line summary of the extended terms a round carries (only what is set).
+function ExtendedTerms({ r, t }) {
+  const parts = []
+  if (r.quality_grade) parts.push(`${t('negotiation.counterGrade')}: ${r.quality_grade}`)
+  if (r.pickup_mode) parts.push(`${t('negotiation.counterPickupMode')}: ${t(`negotiation.pickupMode.${r.pickup_mode}`)}`)
+  if (r.pickup_date) parts.push(`${t('negotiation.counterPickupDate')}: ${r.pickup_date}`)
+  if (r.delivery_location) parts.push(`${t('negotiation.counterDeliveryLocation')}: ${r.delivery_location}`)
+  if (r.delivery_deadline) parts.push(`${t('negotiation.counterDeliveryDeadline')}: ${r.delivery_deadline}`)
+  if (!parts.length && !r.quality_notes) return null
+  return (
+    <div className="text-ink/60 dark:text-paper/60 mt-0.5">
+      {parts.join(' · ')}
+      {r.quality_notes && <div>{t('negotiation.counterQualityNotes')}: {r.quality_notes}</div>}
+    </div>
+  )
+}
