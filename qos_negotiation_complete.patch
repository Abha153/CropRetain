 const ROUND_TONE = { PENDING: 'info', COUNTERED: 'neutral', ACCEPTED: 'success', REJECTED: 'warning', WITHDRAWN: 'neutral' }
+const PICKUP_MODES = ['BUYER_PICKUP', 'FARMER_DELIVERY', 'TO_BE_AGREED']
