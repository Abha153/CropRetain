@@ -0,0 +1,188 @@
+"""
+Tests for the negotiation additions on top of the existing multi-round system:
+extended terms (quality / pickup / delivery) that carry from round to round,
+"a counter must change something", and the immutable agreement snapshot with
+its SHA-256 fingerprint (written in the same DB transaction as the Transaction).
+
+Real JWTs through a real FastAPI app on in-memory SQLite, like
+test_offer_negotiation.py. Run: pytest backend/tests/test_offer_agreement.py -v
+"""
+import hashlib
+import json
+import os
+import sys
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app import models
+from app.auth_utils import create_access_token
+from app.database import Base, get_db
+from app.routers import offer_negotiation as neg_router
+from app.routers import offers as offers_router
+from app.routers import transactions as txn_router
+from app.services import offer_negotiation as svc
+
+
+@pytest.fixture()
+def d():
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False}, poolclass=StaticPool)
+    Base.metadata.create_all(bind=engine)
+    Maker = sessionmaker(bind=engine)
+    app = FastAPI()
+    for r in (offers_router.router, neg_router.router, txn_router.router):
+        app.include_router(r)
+
+    def _db():
+        s = Maker()
+        try:
+            yield s
+        finally:
+            s.close()
+    app.dependency_overrides[get_db] = _db
+    db = Maker()
+    farmer = models.Farmer(name="F", email="f@x.in", password_hash="x", location="Bilaspur", phone="9")
+    buyer = models.Buyer(company_name="B", email="b@x.in", password_hash="x", location="Raipur", phone="8")
+    other = models.Buyer(company_name="Other", email="o@x.in", password_hash="x", location="Raipur", phone="7")
+    db.add_all([farmer, buyer, other]); db.flush()
+    listing = models.CropListing(farmer_id=farmer.id, crop="Tomato", quantity_kg=100, expected_price_per_kg=30,
+                                 location="Bilaspur", available_date="2026-10-01")
+    db.add(listing); db.commit()
+    H = lambda u, role: {"Authorization": f"Bearer {create_access_token(u.email, role)}"}
+    c = TestClient(app)
+    oid = c.post("/offers", json={"listing_id": listing.id, "offered_price_per_kg": 24, "quantity_kg": 40},
+                 headers=H(buyer, "buyer")).json()["id"]
+    yield {"c": c, "db": db, "oid": oid, "fh": H(farmer, "farmer"), "bh": H(buyer, "buyer"),
+           "oh": H(other, "buyer"), "farmer": farmer, "buyer": buyer}
+    db.close()
+
+
+def counter(d, headers, price, **kw):
+    return d["c"].post(f"/offers/{d['oid']}/counter", json={"price_per_kg": price, **kw}, headers=headers)
+
+
+def latest_round_id(d):
+    return d["c"].get(f"/offers/{d['oid']}/rounds", headers=d["fh"]).json()[-1]["id"]
+
+
+# ── extended terms ───────────────────────────────────────────────────────────
+def test_extended_terms_are_stored_and_inherited_by_later_rounds(d):
+    r = counter(d, d["fh"], 28, quality_grade="a", pickup_mode="FARMER_DELIVERY", pickup_date="2026-11-02",
+                delivery_location="Raipur mandi", delivery_deadline="2026-11-04", quality_notes="Sorted, no bruising")
+    assert r.status_code == 200, r.text
+    assert r.json()["quality_grade"] == "A"                      # normalised
+    # buyer answers changing ONLY the price: every other term is carried over
+    r2 = counter(d, d["bh"], 26)
+    assert r2.status_code == 200, r2.text
+    j = r2.json()
+    assert (j["quality_grade"], j["pickup_mode"], j["pickup_date"], j["delivery_location"],
+            j["delivery_deadline"], j["quality_notes"]) == \
+           ("A", "FARMER_DELIVERY", "2026-11-02", "Raipur mandi", "2026-11-04", "Sorted, no bruising")
+
+
+def test_history_keeps_every_rounds_own_terms(d):
+    counter(d, d["fh"], 28, quality_grade="A")
+    counter(d, d["bh"], 26, quality_grade="B")
+    rounds = d["c"].get(f"/offers/{d['oid']}/rounds", headers=d["fh"]).json()
+    assert [x["quality_grade"] for x in rounds] == [None, "A", "B"]
+    assert [x["price_per_kg"] for x in rounds] == [24, 28, 26]
+
+
+@pytest.mark.parametrize("body", [
+    {"quality_grade": "Z"},
+    {"pickup_mode": "TELEPORT"},
+    {"pickup_date": "02/11/2026"},
+    {"delivery_deadline": "not-a-date"},
+    {"pickup_date": "2026-11-05", "delivery_deadline": "2026-11-01"},
+])
+def test_invalid_extended_terms_are_rejected(d, body):
+    r = counter(d, d["fh"], 28, **body)
+    assert r.status_code == 400, r.text
+
+
+def test_overlong_text_is_rejected(d):
+    assert counter(d, d["fh"], 28, quality_notes="x" * 601).status_code == 422
+    assert counter(d, d["fh"], 28, quality_notes="x" * 501).status_code == 400
+
+
+def test_counter_must_change_at_least_one_term(d):
+    r = counter(d, d["fh"], 24, quantity_kg=40)                  # identical to the outstanding round
+    assert r.status_code == 400 and "at least one term" in r.json()["detail"]
+    assert counter(d, d["fh"], 24, quantity_kg=40, quality_grade="A").status_code == 200   # a term changed
+
+
+# ── agreement snapshot + fingerprint ─────────────────────────────────────────
+def _accept(d, headers):
+    """Accept the outstanding round; asserts it really happened (no vacuous passes)."""
+    r = d["c"].post(f"/offers/{d['oid']}/rounds/{latest_round_id(d)}/accept", headers=headers)
+    assert r.status_code == 200, r.text
+    return r
+
+
+def test_accept_writes_agreement_with_sha256_of_canonical_terms(d):
+    counter(d, d["fh"], 28, quality_grade="A", pickup_mode="BUYER_PICKUP", pickup_date="2026-11-02")
+    acc = _accept(d, d["bh"])
+    assert acc.status_code == 200, acc.text
+    ag = d["c"].get(f"/offers/{d['oid']}/agreement", headers=d["fh"]).json()
+    assert ag["transaction_id"] == acc.json()["transaction_id"] and ag["accepted_by"] == "buyer"
+    assert ag["rounds_count"] == 2 and ag["intact"] is True
+    t = ag["terms"]
+    assert (t["price_per_kg"], t["quantity_kg"], t["total_amount"]) == (28, 40, 1120.0)
+    assert (t["quality_grade"], t["pickup_mode"], t["pickup_date"]) == ("A", "BUYER_PICKUP", "2026-11-02")
+    canonical = json.dumps(t, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    assert ag["terms_hash"] == hashlib.sha256(canonical.encode()).hexdigest() and len(ag["terms_hash"]) == 64
+
+
+def test_agreement_and_transaction_and_timeline_event_are_created_together(d):
+    acc = _accept(d, d["fh"]).json()
+    db = d["db"]; db.expire_all()
+    ag = db.query(models.OfferAgreement).one()
+    txn = db.query(models.Transaction).one()
+    assert ag.transaction_id == txn.id == acc["transaction_id"] and ag.round_id == acc["round_id"]
+    ev = [e.event_type for e in db.query(models.TransactionEvent).filter_by(transaction_id=txn.id).all()]
+    assert "AGREEMENT_RECORDED" in ev
+
+
+def test_legacy_farmer_accept_also_records_an_agreement(d):
+    r = d["c"].patch(f"/offers/{d['oid']}/accept", headers=d["fh"])
+    assert r.status_code == 200, r.text
+    ag = d["c"].get(f"/offers/{d['oid']}/agreement", headers=d["bh"]).json()   # buyer can read it too
+    assert ag["terms"]["price_per_kg"] == 24 and ag["intact"] is True
+
+
+def test_tampering_with_stored_terms_is_detected(d):
+    _accept(d, d["fh"])
+    db = d["db"]
+    ag = db.query(models.OfferAgreement).one()
+    ag.terms = {**ag.terms, "price_per_kg": 99}
+    db.commit()
+    got = d["c"].get(f"/offers/{d['oid']}/agreement", headers=d["fh"]).json()
+    assert got["intact"] is False
+    assert svc.agreement_intact(db.query(models.OfferAgreement).one()) is False
+
+
+def test_agreement_is_participants_only_and_absent_before_acceptance(d):
+    assert d["c"].get(f"/offers/{d['oid']}/agreement", headers=d["fh"]).status_code == 404   # not accepted yet
+    _accept(d, d["fh"])
+    assert d["c"].get(f"/offers/{d['oid']}/agreement", headers=d["oh"]).status_code == 404   # non-participant: no leak
+    assert d["c"].get(f"/offers/{d['oid']}/agreement").status_code == 401
+
+
+def test_thread_view_includes_agreement_after_acceptance(d):
+    assert d["c"].get(f"/offers/{d['oid']}", headers=d["fh"]).json()["agreement"] is None
+    _accept(d, d["fh"])
+    th = d["c"].get(f"/offers/{d['oid']}", headers=d["fh"]).json()
+    assert th["agreement"]["terms_hash"] and th["transaction_id"] == th["agreement"]["transaction_id"]
+
+
+def test_fingerprint_is_deterministic_and_order_independent():
+    a = {"price_per_kg": 1, "quantity_kg": 2}
+    b = {"quantity_kg": 2, "price_per_kg": 1}
+    assert svc.terms_fingerprint(a) == svc.terms_fingerprint(b)
+    assert svc.terms_fingerprint(a) != svc.terms_fingerprint({"price_per_kg": 1, "quantity_kg": 3})
