+    body = {"target_type": "PERFORMANCE_RECORD", "target_id": rid, "reason": REASON}
+    assert d["c"].post("/reputation/disputes", json=body, headers=d["b2h"]).status_code == 404   # other buyer
+    assert d["c"].post("/reputation/disputes", json=body, headers=d["fh"]).status_code == 403    # farmers don't contest
+    trip = {"target_type": "TRANSPORT_REQUEST", "target_id": d["trip"].id, "reason": REASON}
+    assert d["c"].post("/reputation/disputes", json=trip, headers=d["t2h"]).status_code == 404   # other agency
+    assert d["c"].post("/reputation/disputes", json={**trip, "reason": "short"}, headers=d["th"]).status_code == 422
+    assert d["c"].post("/reputation/disputes", json={**trip, "target_type": "GRIEVANCE"}, headers=d["th"]).status_code == 400
