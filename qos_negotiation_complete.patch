+"""
+Reputation indicators depend on WHO cancelled a trip. These tests pin that every
+cancellation path records the canceller, and that nothing is guessed for rows
+that predate the column. Run: pytest backend/tests/test_reputation_evidence_capture.py -v
+"""
+import os
+import sys
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app import models
+from app.auth_utils import create_access_token
+from app.database import Base, get_db
+from app.routers import transport as transport_router
+from app.routers import transport_negotiation as tn_router
+from app.services import reputation as rep
+
+
+def H(email, role):
+    return {"Authorization": f"Bearer {create_access_token(email, role)}"}
+
+
+@pytest.fixture()
+def d():
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False}, poolclass=StaticPool)
+    Base.metadata.create_all(bind=engine)
+    Maker = sessionmaker(bind=engine)
+    app = FastAPI()
+    app.include_router(transport_router.router)
+    app.include_router(tn_router.router)
+
+    def _db():
+        s = Maker()
+        try:
+            yield s
+        finally:
+            s.close()
+    app.dependency_overrides[get_db] = _db
+    db = Maker()
+    f = models.Farmer(name="F", email="f@x.in", password_hash="x", location="Bilaspur")
+    t = models.Transporter(name="T", email="t@x.in", password_hash="x")
+    db.add_all([f, t]); db.flush()
+
+    def trip(status="CONFIRMED", **kw):
+        r = models.TransportRequest(farmer_id=f.id, transporter_id=t.id, pickup_location="A", destination="B",
+                                    status=status, negotiation_status="AGREED", **kw)
+        db.add(r); db.commit(); return r
+    yield {"c": TestClient(app), "db": db, "f": f, "t": t, "trip": trip,
+           "fh": H(f.email, "farmer"), "th": H(t.email, "transporter")}
+    db.close()
+
+
+def test_farmer_cancel_endpoint_records_farmer(d):
+    r = d["trip"]()
+    assert d["c"].patch(f"/transport/requests/{r.id}/cancel", headers=d["fh"]).status_code == 200
+    d["db"].expire_all()
+    got = d["db"].get(models.TransportRequest, r.id)
+    assert (got.status, got.cancelled_by) == ("CANCELLED", "farmer") and got.cancelled_at is not None
+
+
+def test_farmer_status_endpoint_cancel_records_farmer(d):
+    r = d["trip"]()
+    res = d["c"].patch(f"/transport/requests/{r.id}/status", json={"status": "CANCELLED"}, headers=d["fh"])
+    assert res.status_code == 200, res.text
+    d["db"].expire_all()
+    assert d["db"].get(models.TransportRequest, r.id).cancelled_by == "farmer"
+
+
+def test_transporter_cancel_records_transporter_and_counts_against_agency(d):
+    r = d["trip"]()
+    res = d["c"].post(f"/transport/requests/{r.id}/transporter-status", json={"status": "CANCELLED"}, headers=d["th"])
+    assert res.status_code == 200, res.text
+    d["db"].expire_all()
+    got = d["db"].get(models.TransportRequest, r.id)
+    assert (got.status, got.cancelled_by) == ("CANCELLED", "transporter")
+    hist = rep.transporter_profile(d["db"], d["t"].id)["trip_history"]
+    assert hist["cancelled_by_agency"] == 1 and hist["cancelled_other_or_unrecorded"] == 0
+
+
+def test_farmer_cancel_is_not_counted_against_the_agency(d):
+    r = d["trip"]()
+    assert d["c"].patch(f"/transport/requests/{r.id}/cancel", headers=d["fh"]).status_code == 200
+    d["db"].expire_all()
+    hist = rep.transporter_profile(d["db"], d["t"].id)["trip_history"]
+    assert hist["cancelled_by_agency"] == 0 and hist["cancelled_other_or_unrecorded"] == 1
+
+
+def test_legacy_cancelled_rows_with_no_canceller_are_never_blamed(d):
+    d["trip"](status="CANCELLED")                      # predates the column: cancelled_by is NULL
+    hist = rep.transporter_profile(d["db"], d["t"].id)["trip_history"]
+    assert hist["cancelled_by_agency"] == 0 and hist["cancelled_other_or_unrecorded"] == 1
+
+
+def test_request_dict_exposes_final_charge_and_promise(d):
+    r = d["trip"](status="DELIVERED", final_charge=1234.0, promised_delivery_by="2026-11-01")
+    rows = d["c"].get("/transport/requests/mine", headers=d["fh"])
+    assert rows.status_code == 200, rows.text
+    item = [x for x in rows.json() if x["id"] == r.id][0]
+    assert item["final_charge"] == 1234.0 and item["promised_delivery_by"] == "2026-11-01"
