index fd54ca2..80fdf66 100644
--- a/backend/app/models.py
+++ b/backend/app/models.py
@@ -143,6 +143,17 @@ class BuyerOfferRound(Base):
     created_at = Column(DateTime, default=now)
     responded_at = Column(DateTime, nullable=True)
 
+    # Extended deal terms (all nullable, additive: rounds created before
+    # these columns existed simply have none). A counter inherits every one
+    # of these from the round it answers unless the sender changes it, so a
+    # round always shows the COMPLETE terms on the table, not a diff.
+    quality_grade = Column(String, nullable=True)        # A / B / C
+    quality_notes = Column(Text, nullable=True)
+    pickup_mode = Column(String, nullable=True)          # BUYER_PICKUP / FARMER_DELIVERY / TO_BE_AGREED
