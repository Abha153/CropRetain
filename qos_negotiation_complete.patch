+    terms["pickup_date"] = _clean_date(terms.get("pickup_date"), "Pickup date")
+    terms["delivery_deadline"] = _clean_date(terms.get("delivery_deadline"), "Delivery deadline")
+    if terms["pickup_date"] and terms["delivery_deadline"] and terms["delivery_deadline"] < terms["pickup_date"]:
