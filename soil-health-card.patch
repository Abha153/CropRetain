diff --git a/backend/app/services/soil_health_card.py b/backend/app/services/soil_health_card.py
new file mode 100644
index 0000000..fd6b6bb
--- /dev/null
+++ b/backend/app/services/soil_health_card.py
@@ -0,0 +1,161 @@
+"""
+Soil Health Card (SHC) value interpretation for the Soil Advisor.
+
+What this is: it classifies the nutrient / organic-carbon / EC values a
+farmer reads off a Soil Health Card or soil-test report into the published
+fertility classes (low / medium / high; EC classes), and reports the
+class according to EACH cited source.
+
+What this is NOT:
+  * not a crop-suitability check -- the classes describe the soil, they are
+    not matched to a crop (no cited crop-specific nutrient rule is loaded);
+  * not a fertiliser recommendation (none is cited, so none is given);
+  * not a soil test. Values are whatever the farmer typed in.
+
+Honesty rules (same as soil_crop_rules.py):
+  * Every limit has a source id in soil_crop_rules.SOURCES.
+  * The two sources DISAGREE on several limits (N, P, K, EC). They are kept
+    as separate claims and the disagreement is surfaced, never averaged.
+  * Input confidence is only "farmer_reported" or "card_based". A
+    "regional_estimate" level is deliberately NOT supported: no cited
+    district-level soil data is loaded, and inventing district averages
+    would break the rules above.
+
+Source quirks (kept visible, not silently "fixed"):
+  * TNAU's organic-carbon row prints the Medium range as "0.5 - 7.5%" while
+    High starts above 0.75%. We read the Medium upper bound as 0.75 (so the
+    two sources agree) and flag the claim `interpreted=True`.
+  * The ICAR-IISS table gives phosphorus as Olsen-P and only two EC classes
+    and states no EC unit; TNAU labels EC "milli mhos/cm2". Units for EC are
+    therefore not asserted here -- the farmer should use the unit printed on
+    their card.
+"""
+from typing import Optional
+
+CONFIDENCE_FARMER = "farmer_reported"
+CONFIDENCE_CARD = "card_based"
+CONFIDENCE_LEVELS = [CONFIDENCE_FARMER, CONFIDENCE_CARD]
+
+# Fertility-class parameters that use low / medium / high.
+#   low_below : value < low_below            -> "low"
+#   high_above: value > high_above           -> "high"
+#   otherwise                                 -> "medium"
+GRADED = {
+    "nitrogen": {
+        "unit": "kg/ha", "label_key": "nitrogen",
+        "claims": [
+            {"source": "iiss_shc_2021", "low_below": 280, "high_above": 560,
+             "method": "available N", "interpreted": False},
+            {"source": "tnau_soil_rating", "low_below": 240, "high_above": 480,
+             "method": "available N", "interpreted": False},
+        ],
+    },
+    "phosphorus": {
+        "unit": "kg/ha", "label_key": "phosphorus",
+        "claims": [
+            {"source": "iiss_shc_2021", "low_below": 10, "high_above": 25,
+             "method": "Olsen P", "interpreted": False},
+            {"source": "tnau_soil_rating", "low_below": 11, "high_above": 22,
+             "method": "method not stated", "interpreted": False},
+        ],
+    },
+    "potassium": {
+        "unit": "kg/ha", "label_key": "potassium",
+        "claims": [
+            {"source": "iiss_shc_2021", "low_below": 120, "high_above": 280,
+             "method": "1N NH4OAc K", "interpreted": False},
+            {"source": "tnau_soil_rating", "low_below": 110, "high_above": 280,
+             "method": "method not stated", "interpreted": False},
+        ],
+    },
+    "organic_carbon": {
+        "unit": "%", "label_key": "organic_carbon",
+        "claims": [
+            {"source": "iiss_shc_2021", "low_below": 0.5, "high_above": 0.75,
+             "method": "organic carbon", "interpreted": False},
+            # Printed "0.5 - 7.5%" for Medium; read as 0.75 (see module note).
+            {"source": "tnau_soil_rating", "low_below": 0.5, "high_above": 0.75,
+             "method": "organic carbon", "interpreted": True},
+        ],
+    },
+}
+
+# EC uses named classes, and the two sources use different class sets.
+# Each class: (upper bound, exclusive-of-next, class code). The last bound is
+# open-ended (None).
+EC_CLAIMS = [
+    {"source": "iiss_shc_2021",
+     "classes": [(4.0, "normal"), (None, "saline")]},
+    {"source": "tnau_soil_rating",
+     "classes": [(1.0, "normal"), (2.0, "critical_germination"),
+                 (4.0, "critical_sensitive_growth"), (None, "above_listed_range")]},
+]
+
+FACTORS = list(GRADED) + ["ec"]
+
+
+def _grade(value: float, claim: dict) -> str:
+    if value < claim["low_below"]:
+        return "low"
+    if value > claim["high_above"]:
+        return "high"
+    return "medium"
+
+
+def _ec_class(value: float, classes: list) -> str:
+    for upper, code in classes:
+        if upper is None or value < upper:
+            return code
+    return classes[-1][1]  # unreachable; keeps the function total
+
+
+def classify_factor(factor: str, value: float, confidence: str) -> dict:
+    """Classify one Soil Health Card value under every cited source."""
+    if factor in GRADED:
+        spec = GRADED[factor]
+        assessments = [{
+            "source": c["source"], "class": _grade(value, c),
+            "low_below": c["low_below"], "high_above": c["high_above"],
+            "method": c["method"], "interpreted": c["interpreted"],
+        } for c in spec["claims"]]
+        disagree = len({a["class"] for a in assessments}) > 1
+        unit = spec["unit"]
+    elif factor == "ec":
+        assessments = [{
+            "source": c["source"], "class": _ec_class(value, c["classes"]),
+            "interpreted": False,
+        } for c in EC_CLAIMS]
+        # Class sets differ between sources, so compare the one thing both
+        # state: is the value "normal" or not.
+        disagree = len({a["class"] == "normal" for a in assessments}) > 1
+        unit = None  # sources do not state a consistent unit
+    else:  # pragma: no cover - guarded by callers
+        raise ValueError(f"unknown soil health factor: {factor}")
+    return {
+        "factor": factor, "value": value, "unit": unit,
+        "confidence": confidence, "assessments": assessments,
+        "sources_disagree": disagree,
+    }
+
+
+def classify_all(values: dict, confidence_by_factor: dict) -> list:
+    """`values` maps factor -> number (None / missing factors are skipped).
+    Returns results in FACTORS order for a stable UI."""
+    out = []
+    for factor in FACTORS:
+        v: Optional[float] = values.get(factor)
+        if v is None:
+            continue
+        out.append(classify_factor(
+            factor, v, confidence_by_factor.get(factor, CONFIDENCE_FARMER)))
+    return out
+
+
+def source_ids(results: list) -> set:
+    return {a["source"] for r in results for a in r["assessments"]}
+
+
+__all__ = [
+    "CONFIDENCE_LEVELS", "CONFIDENCE_FARMER", "CONFIDENCE_CARD", "FACTORS",
+    "classify_factor", "classify_all", "source_ids",
+]
diff --git a/backend/tests/test_soil_advisor.py b/backend/tests/test_soil_advisor.py
index 1f4dc95..435a27e 100644
--- a/backend/tests/test_soil_advisor.py
+++ b/backend/tests/test_soil_advisor.py
@@ -231,3 +231,106 @@ def test_existing_market_compare_still_works(client, db):
     _seed_demo(db, "Soybean", {m["name"]: 4300.0 for m in MARKETS[:6]})
     r = client.get("/market/compare", params={"crop": "Soybean", "quantity_kg": 500, "location": "Bilaspur"})
     assert r.status_code == 200 and r.json()["options"]
+
+
+# ------------------------------------------- Soil Health Card values ------
+
+from app.services import soil_health_card as shc  # noqa: E402
+
+
+def test_every_shc_claim_cites_a_known_source():
+    for spec in shc.GRADED.values():
+        for c in spec["claims"]:
+            assert c["source"] in SOURCES
+            assert c["low_below"] < c["high_above"]
+    for c in shc.EC_CLAIMS:
+        assert c["source"] in SOURCES
+
+
+@pytest.mark.parametrize("value,iiss,tnau,disagree", [
+    (260, "low", "medium", True),      # between TNAU's 240 and ICAR-IISS's 280
+    (280, "medium", "medium", False),  # boundary: 280 is Medium, not Low
+    (560, "medium", "high", True),     # 560 is Medium for IISS, High for TNAU (>480)
+    (561, "high", "high", False),
+])
+def test_nitrogen_classes_per_source_and_disagreement(value, iiss, tnau, disagree):
+    r = shc.classify_factor("nitrogen", value, "card_based")
+    by = {a["source"]: a["class"] for a in r["assessments"]}
+    assert by["iiss_shc_2021"] == iiss and by["tnau_soil_rating"] == tnau
+    assert r["sources_disagree"] is disagree
+    assert r["unit"] == "kg/ha" and r["confidence"] == "card_based"
+
+
+def test_organic_carbon_tnau_typo_is_flagged_interpreted():
+    r = shc.classify_factor("organic_carbon", 0.6, "farmer_reported")
+    tnau = next(a for a in r["assessments"] if a["source"] == "tnau_soil_rating")
+    assert tnau["interpreted"] is True and tnau["class"] == "medium"
+    assert r["sources_disagree"] is False
+
+
+def test_ec_has_no_asserted_unit_and_surfaces_class_disagreement():
+    r = shc.classify_factor("ec", 1.5, "farmer_reported")
+    assert r["unit"] is None
+    by = {a["source"]: a["class"] for a in r["assessments"]}
+    assert by == {"iiss_shc_2021": "normal", "tnau_soil_rating": "critical_germination"}
+    assert r["sources_disagree"] is True
+    # Beyond every "normal" range both sources agree it is not normal.
+    assert shc.classify_factor("ec", 5, "farmer_reported")["sources_disagree"] is False
+
+
+def test_classify_all_skips_missing_values_and_defaults_confidence():
+    out = shc.classify_all({"nitrogen": 300, "potassium": None}, {})
+    assert [r["factor"] for r in out] == ["nitrogen"]
+    assert out[0]["confidence"] == "farmer_reported"
+
+
+def test_regional_estimate_confidence_is_not_a_supported_level():
+    assert shc.CONFIDENCE_LEVELS == ["farmer_reported", "card_based"]
+
+
+def test_api_returns_soil_health_with_card_confidence_and_sources(client):
+    body = client.post("/soil/advise", json={
+        "soil_ph": 6.5, "soil_texture": "loam", "season": "kharif",
+        "nitrogen_kg_ha": 260, "organic_carbon_pct": 0.6, "values_from_card": True,
+    }).json()
+    assert body["inputs"]["confidence"]["ph"] == "card_based"
+    assert body["inputs"]["confidence"]["nitrogen"] == "card_based"
+    assert body["inputs"]["confidence"]["texture"] == "farmer_reported"
+    assert [h["factor"] for h in body["soil_health"]] == ["nitrogen", "organic_carbon"]
+    assert body["soil_health"][0]["sources_disagree"] is True
+    source_ids = {s["id"] for s in body["sources"]}
+    assert {"iiss_shc_2021", "tnau_soil_rating"} <= source_ids
+    for rec in body["recommendations"]:
+        ph_check = next(c for c in rec["checks"] if c["factor"] == "ph")
+        assert ph_check["input_confidence"] == "card_based"
+        # Soil health values must not change which crops are assessed.
+        assert {c["factor"] for c in rec["checks"]} <= {"ph", "texture", "season"}
+
+
+def test_values_default_to_farmer_reported(client):
+    body = client.post("/soil/advise", json={"soil_ph": 6.5, "nitrogen_kg_ha": 300}).json()
+    assert body["inputs"]["confidence"] == {"ph": "farmer_reported", "nitrogen": "farmer_reported"}
+
+
+def test_soil_health_values_alone_are_accepted(client):
+    r = client.post("/soil/advise", json={"potassium_kg_ha": 150})
+    assert r.status_code == 200
+    body = r.json()
+    assert body["recommendations"] == [] and len(body["soil_health"]) == 1
+    assert body["data_quality"] == "ESTIMATED"
+
+
+def test_top_n_caps_recommendations_and_reports_total(client):
+    full = client.post("/soil/advise", json={"soil_ph": 6.5, "soil_texture": "loam", "season": "kharif"}).json()
+    capped = client.post("/soil/advise", json={"soil_ph": 6.5, "soil_texture": "loam", "season": "kharif",
+                                               "top_n": 1}).json()
