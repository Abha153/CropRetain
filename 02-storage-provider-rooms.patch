+"""
+Tests for the storage partner role: registration/auth, facility management and
+room-level inventory (app/routers/storage_provider.py, app/routers/auth.py).
+
+Run: pytest backend/tests/test_storage_provider.py -v
+"""
+import os
+import sys
+
+import pytest
+from fastapi import HTTPException
+from pydantic import ValidationError
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app import models, schemas
+from app.database import Base
+from app.auth_utils import require_storage_provider, require_farmer, get_current_user, create_access_token
+from app.routers import auth as auth_router
+from app.routers import storage_provider as sp
+from app.routers import storage as storage_router
+
+
+@pytest.fixture()
+def db():
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(bind=engine)
+    session = sessionmaker(bind=engine)()
+    yield session
+    session.close()
+
+
+def _register(db, email="p1@example.com", password="secret1"):
+    return auth_router.register_storage_provider(
+        schemas.StorageProviderRegister(
+            name="Owner", email=email, password=password,
+            business_name="Bilaspur Cold Chain", contact_phone="9000000010",
+        ),
+        db,
+    )
+
+
+def _provider(db, email="p1@example.com"):
+    _register(db, email)
+    return db.query(models.StorageProvider).filter_by(email=email).one()
+
+
+def _facility(db, provider, **over):
+    data = dict(name="Cold Store A", location="Bilaspur", capacity_kg=10000, price_per_kg_per_day=0.5)
+    data.update(over)
+    return sp.create_facility(schemas.StorageFacilityCreate(**data), provider, db)
+
+
+# ---- auth -------------------------------------------------------------------
+
+def test_register_creates_pending_provider_and_token(db):
+    resp = _register(db)
+    assert resp["role"] == "storage_provider"
+    assert resp["user"]["verification_status"] == "PENDING"
+    assert "password_hash" not in resp["user"]
+    p = db.query(models.StorageProvider).one()
+    assert p.password_hash != "secret1"
+
+
+def test_duplicate_email_rejected(db):
+    _register(db)
+    with pytest.raises(Exception) as e:
+        _register(db)
+    assert getattr(e.value, "status_code", None) == 400
+
+
+def test_login_and_me_for_storage_provider(db):
+    _register(db)
+
+    class Form:
+        username, password = "p1@example.com", "secret1"
+
+    out = auth_router.login(Form(), db)
+    assert out["role"] == "storage_provider"
+    assert auth_router.me({"user": db.query(models.StorageProvider).one(), "role": "storage_provider"})["role"] == "storage_provider"
+
+    class Bad:
+        username, password = "p1@example.com", "wrong"
+
+    with pytest.raises(Exception) as e:
+        auth_router.login(Bad(), db)
+    assert getattr(e.value, "status_code", None) == 401
+
+
+def test_token_resolves_to_provider_and_rbac(db):
+    _register(db)
+    token = create_access_token(subject="p1@example.com", role="storage_provider")
+    current = get_current_user(token=token, db=db)
+    assert current["role"] == "storage_provider"
+    assert require_storage_provider(current).email == "p1@example.com"
+    with pytest.raises(HTTPException) as e:
+        require_farmer(current)
+    assert e.value.status_code == 403
+    farmer_current = {"role": "farmer", "user": object()}
+    with pytest.raises(HTTPException) as e:
+        require_storage_provider(farmer_current)
+    assert e.value.status_code == 403
+
+
+# ---- facilities -------------------------------------------------------------
+
+def test_create_facility_defaults(db):
+    p = _provider(db)
+    d = _facility(db, p, operating_hours="6am-8pm", images=["a.jpg"])
+    assert d["available_capacity_kg"] == 10000
+    assert d["is_demo"] is False and d["verification_status"] == "UNVERIFIED" and d["status"] == "ACTIVE"
+    assert d["operating_hours"] == "6am-8pm" and d["images"] == ["a.jpg"]
+    f = db.query(models.StorageFacility).one()
+    assert f.provider_id == p.id
+
+
+def test_facility_validation():
+    with pytest.raises(ValidationError):
+        schemas.StorageFacilityCreate(name="x", location="y", capacity_kg=0, price_per_kg_per_day=1)
+    with pytest.raises(ValidationError):
+        schemas.StorageFacilityCreate(name="x", location="y", capacity_kg=1, price_per_kg_per_day=1,
+                                      facility_type="GOVERNMENT_STORAGE")
+
+
+def test_facilities_are_owner_scoped(db):
+    p1, p2 = _provider(db), _provider(db, "p2@example.com")
+    fac = _facility(db, p1)
+    assert [f["id"] for f in sp.list_my_facilities(p1, db)] == [fac["id"]]
+    assert sp.list_my_facilities(p2, db) == []
+    for call in (
+        lambda: sp.get_my_facility(fac["id"], p2, db),
+        lambda: sp.update_facility(fac["id"], schemas.StorageFacilityUpdate(name="Hijack"), p2, db),
+        lambda: sp.add_room(fac["id"], schemas.StorageRoomCreate(room_name="R", room_type="DRY", capacity_kg=1), p2, db),
+        lambda: sp.list_rooms(fac["id"], p2, db),
+    ):
+        with pytest.raises(HTTPException) as e:
+            call()
+        assert e.value.status_code == 404
+
+
+def test_update_facility_preserves_booked_stock(db):
+    p = _provider(db)
+    fac = _facility(db, p)
+    f = db.query(models.StorageFacility).one()
+    f.available_capacity_kg = 7000  # 3000 kg already booked
+    db.commit()
+    out = sp.update_facility(fac["id"], schemas.StorageFacilityUpdate(capacity_kg=12000), p, db)
+    assert out["capacity_kg"] == 12000 and out["available_capacity_kg"] == 9000
+    with pytest.raises(HTTPException) as e:
+        sp.update_facility(fac["id"], schemas.StorageFacilityUpdate(capacity_kg=2000), p, db)
+    assert e.value.status_code == 400
+
+
+def test_inactive_facility_hidden_from_marketplace(db):
+    p = _provider(db)
+    fac = _facility(db, p)
+    assert len(storage_router.list_facilities(None, None, None, db)) == 1
+    sp.update_facility(fac["id"], schemas.StorageFacilityUpdate(status="INACTIVE"), p, db)
+    assert storage_router.list_facilities(None, None, None, db) == []
+
+
+# ---- rooms ------------------------------------------------------------------
+
+def test_room_crud_and_capacity_rules(db):
+    p = _provider(db)
+    fac = _facility(db, p)
+    room = sp.add_room(fac["id"], schemas.StorageRoomCreate(room_name="Room 1", room_type="COLD", capacity_kg=2000), p, db)
+    assert room.available_capacity_kg == 2000
+    assert [r.id for r in sp.list_rooms(fac["id"], p, db)] == [room.id]
+
+    out = sp.update_room(room.id, schemas.StorageRoomUpdate(available_capacity_kg=1500), p, db)
+    assert out.available_capacity_kg == 1500
+    with pytest.raises(HTTPException) as e:
+        sp.update_room(room.id, schemas.StorageRoomUpdate(capacity_kg=1000), p, db)  # 1500 avail > 1000
+    assert e.value.status_code == 422
+
+    sp.delete_room(room.id, p, db)
+    assert sp.list_rooms(fac["id"], p, db) == []
+
+
+def test_room_validation_and_unique_name(db):
+    with pytest.raises(ValidationError):
+        schemas.StorageRoomCreate(room_name="R", room_type="DRY", capacity_kg=100, available_capacity_kg=200)
+    p = _provider(db)
+    fac = _facility(db, p)
+    sp.add_room(fac["id"], schemas.StorageRoomCreate(room_name="Room 1", room_type="DRY", capacity_kg=100), p, db)
+    with pytest.raises(HTTPException) as e:
+        sp.add_room(fac["id"], schemas.StorageRoomCreate(room_name="Room 1", room_type="COLD", capacity_kg=50), p, db)
+    assert e.value.status_code == 409
+
+
+def test_room_ops_blocked_across_providers(db):
+    p1, p2 = _provider(db), _provider(db, "p2@example.com")
+    fac = _facility(db, p1)
+    room = sp.add_room(fac["id"], schemas.StorageRoomCreate(room_name="Room 1", room_type="DRY", capacity_kg=100), p1, db)
+    for call in (
+        lambda: sp.update_room(room.id, schemas.StorageRoomUpdate(room_name="X"), p2, db),
+        lambda: sp.delete_room(room.id, p2, db),
+    ):
+        with pytest.raises(HTTPException) as e:
+            call()
+        assert e.value.status_code == 404
+
+
+def test_profile_update(db):
+    p = _provider(db)
+    out = sp.update_profile(schemas.StorageProviderUpdate(business_name="New Name", alternate_phone="9111111111"), p, db)
+    assert out.business_name == "New Name" and out.alternate_phone == "9111111111"
+    assert out.verification_status == "PENDING"
