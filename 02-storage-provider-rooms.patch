+    @model_validator(mode="after")
+    def _available_within_capacity(self):
+        if self.available_capacity_kg is not None and self.available_capacity_kg > self.capacity_kg:
+            raise ValueError("available_capacity_kg cannot exceed capacity_kg")
+        return self
+
+
+class StorageRoomUpdate(BaseModel):
+    room_name: Optional[str] = Field(None, min_length=1)
+    room_type: Optional[str] = Field(None, min_length=1)
+    capacity_kg: Optional[float] = Field(None, gt=0)
+    available_capacity_kg: Optional[float] = Field(None, ge=0)
+
+
+class StorageRoomOut(BaseModel):
+    model_config = ConfigDict(from_attributes=True)
+    id: int
+    facility_id: int
+    room_name: str
+    room_type: str
+    capacity_kg: float
+    available_capacity_kg: float
+
+
 class StorageBookingCreate(BaseModel):
     storage_facility_id: int
     lot_id: Optional[int] = None
