diff --git a/backend/app/routers/storage_provider.py b/backend/app/routers/storage_provider.py
new file mode 100644
index 0000000..d753663
--- /dev/null
+++ b/backend/app/routers/storage_provider.py
@@ -0,0 +1,221 @@
+"""
+Storage partner (warehouse / cold-storage operator) endpoints: profile,
+facility management and room-level inventory. All routes are scoped to the
+authenticated provider's own facilities; another provider's facility or room
+is always reported as 404.
+
+Farmer-facing browsing and booking stay in app/routers/storage.py.
+"""
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from app.database import get_db
+from app import models, schemas
+from app.auth_utils import require_storage_provider
+from app.routers.storage import _facility_dict
+
+router = APIRouter(prefix="/storage-provider", tags=["storage-provider"])
+
+
+# --- helpers -----------------------------------------------------------------
+
+def _own_facility_or_404(db: Session, provider: models.StorageProvider, facility_id: int) -> models.StorageFacility:
+    f = (
+        db.query(models.StorageFacility)
+        .filter(models.StorageFacility.id == facility_id, models.StorageFacility.provider_id == provider.id)
+        .first()
+    )
+    if not f:
+        raise HTTPException(status_code=404, detail="Storage facility not found")
+    return f
+
+
+def _own_room_or_404(db: Session, provider: models.StorageProvider, room_id: int) -> models.StorageRoom:
+    room = (
+        db.query(models.StorageRoom)
+        .join(models.StorageFacility, models.StorageRoom.facility_id == models.StorageFacility.id)
+        .filter(models.StorageRoom.id == room_id, models.StorageFacility.provider_id == provider.id)
+        .first()
+    )
+    if not room:
+        raise HTTPException(status_code=404, detail="Storage room not found")
+    return room
+
+
+def _facility_owner_dict(f: models.StorageFacility) -> dict:
+    d = _facility_dict(f)
+    d["rooms"] = [schemas.StorageRoomOut.model_validate(r).model_dump() for r in sorted(f.rooms, key=lambda r: r.id)]
+    return d
+
+
+def _ensure_room_name_free(db: Session, facility_id: int, room_name: str, exclude_id: int | None = None):
+    q = db.query(models.StorageRoom).filter(
+        models.StorageRoom.facility_id == facility_id, models.StorageRoom.room_name == room_name
+    )
+    if exclude_id is not None:
+        q = q.filter(models.StorageRoom.id != exclude_id)
+    if q.first():
+        raise HTTPException(status_code=409, detail="A room with this name already exists in this facility")
+
+
+# --- profile -----------------------------------------------------------------
+
+@router.get("/profile", response_model=schemas.StorageProviderOut)
+def my_profile(provider: models.StorageProvider = Depends(require_storage_provider)):
+    return provider
+
+
+@router.patch("/profile", response_model=schemas.StorageProviderOut)
+def update_profile(
+    payload: schemas.StorageProviderUpdate,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    for key, value in payload.model_dump(exclude_unset=True).items():
+        # Required columns ignore an explicit null rather than writing NULL.
+        if value is None and key != "alternate_phone":
+            continue
+        setattr(provider, key, value)
+    db.commit()
+    db.refresh(provider)
+    return provider
+
+
+# --- facilities --------------------------------------------------------------
+
+@router.post("/facilities", status_code=201)
+def create_facility(
+    payload: schemas.StorageFacilityCreate,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    """Lists a facility owned by this provider. It starts UNVERIFIED (an
+    existing facility verification value) and is never marked demo."""
+    facility = models.StorageFacility(
+        provider_id=provider.id,
+        available_capacity_kg=payload.capacity_kg,
+        verification_status="UNVERIFIED",
+        status="ACTIVE",
+        is_demo=False,
+        **payload.model_dump(),
+    )
+    db.add(facility)
+    db.commit()
+    db.refresh(facility)
+    return _facility_owner_dict(facility)
+
+
+@router.get("/facilities")
+def list_my_facilities(
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    facilities = (
+        db.query(models.StorageFacility)
+        .filter(models.StorageFacility.provider_id == provider.id)
+        .order_by(models.StorageFacility.id)
+        .all()
+    )
+    return [_facility_owner_dict(f) for f in facilities]
+
+
+@router.get("/facilities/{facility_id}")
+def get_my_facility(
+    facility_id: int,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    return _facility_owner_dict(_own_facility_or_404(db, provider, facility_id))
+
+
+@router.patch("/facilities/{facility_id}")
+def update_facility(
+    facility_id: int,
+    payload: schemas.StorageFacilityUpdate,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    f = _own_facility_or_404(db, provider, facility_id)
+    changes = payload.model_dump(exclude_unset=True)
+    # Columns that are NOT NULL (or have a non-null default) ignore an explicit null.
+    nullable = {"latitude", "longitude", "contact", "operating_hours"}
+    changes = {k: v for k, v in changes.items() if v is not None or k in nullable}
+    if "capacity_kg" in changes:
+        # Keep already-booked stock intact: booked = old capacity - old available.
+        booked = f.capacity_kg - f.available_capacity_kg
+        if changes["capacity_kg"] < booked:
+            raise HTTPException(
+                status_code=400,
+                detail=f"capacity_kg cannot be lower than the {booked:g} kg currently booked",
+            )
+        f.available_capacity_kg = changes["capacity_kg"] - booked
+    for key, value in changes.items():
+        setattr(f, key, value)
+    db.commit()
+    db.refresh(f)
+    return _facility_owner_dict(f)
+
+
+# --- rooms (room-level inventory) ---------------------------------------------
+
+@router.post("/facilities/{facility_id}/rooms", response_model=schemas.StorageRoomOut, status_code=201)
+def add_room(
+    facility_id: int,
+    payload: schemas.StorageRoomCreate,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    _own_facility_or_404(db, provider, facility_id)
+    _ensure_room_name_free(db, facility_id, payload.room_name)
+    available = payload.capacity_kg if payload.available_capacity_kg is None else payload.available_capacity_kg
+    room = models.StorageRoom(
+        facility_id=facility_id, room_name=payload.room_name, room_type=payload.room_type,
+        capacity_kg=payload.capacity_kg, available_capacity_kg=available,
+    )
+    db.add(room)
+    db.commit()
+    db.refresh(room)
+    return room
+
+
+@router.get("/facilities/{facility_id}/rooms", response_model=list[schemas.StorageRoomOut])
+def list_rooms(
+    facility_id: int,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    f = _own_facility_or_404(db, provider, facility_id)
+    return sorted(f.rooms, key=lambda r: r.id)
+
+
+@router.patch("/rooms/{room_id}", response_model=schemas.StorageRoomOut)
+def update_room(
+    room_id: int,
+    payload: schemas.StorageRoomUpdate,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    room = _own_room_or_404(db, provider, room_id)
+    changes = {k: v for k, v in payload.model_dump(exclude_unset=True).items() if v is not None}
+    if "room_name" in changes:
+        _ensure_room_name_free(db, room.facility_id, changes["room_name"], exclude_id=room.id)
+    capacity = changes.get("capacity_kg", room.capacity_kg)
+    available = changes.get("available_capacity_kg", room.available_capacity_kg)
+    if available > capacity:
+        raise HTTPException(status_code=422, detail="available_capacity_kg cannot exceed capacity_kg")
+    for key, value in changes.items():
+        setattr(room, key, value)
+    db.commit()
+    db.refresh(room)
+    return room
+
+
+@router.delete("/rooms/{room_id}", status_code=204)
+def delete_room(
+    room_id: int,
+    provider: models.StorageProvider = Depends(require_storage_provider),
+    db: Session = Depends(get_db),
+):
+    room = _own_room_or_404(db, provider, room_id)
+    db.delete(room)
+    db.commit()
