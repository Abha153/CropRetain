+@router.put("/onboarding", response_model=schemas.TransporterOut)
+def complete_onboarding(
+    payload: schemas.TransporterOnboarding,
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    """Partner onboarding: fills in business / coverage details on the
+    authenticated transporter's own account. verification_status is never
+    taken from the client -- it stays PENDING until reviewed. Changing the
+    submitted documents on an already-verified/rejected account sends it back
+    to PENDING for re-review."""
+    transporter.business_name = payload.business_name
+    transporter.primary_phone = payload.primary_phone
+    transporter.phone = payload.primary_phone  # keep the legacy phone field in step
+    transporter.whatsapp_number = payload.whatsapp_number
+    transporter.operating_district = payload.operating_district
+    transporter.operating_state = payload.operating_state
+    transporter.service_routes = payload.service_routes
+    transporter.preferred_language = payload.preferred_language
+    if list(transporter.verification_documents or []) != payload.verification_documents:
+        transporter.verification_documents = payload.verification_documents
+        transporter.verification_status = "PENDING"
+    db.commit()
+    db.refresh(transporter)
+    return transporter
+
+
+# --- vehicles (owner-only; registration_number is private) -------------------
+
+def _normalize_reg(value: str) -> str:
+    return "".join(value.split()).upper()
+
+
+def _own_vehicle_or_404(db: Session, transporter: models.Transporter, vehicle_id: int) -> models.TransporterVehicle:
+    v = (
+        db.query(models.TransporterVehicle)
+        .filter(
+            models.TransporterVehicle.id == vehicle_id,
+            models.TransporterVehicle.transporter_id == transporter.id,
+        )
+        .first()
+    )
+    if not v:
+        raise HTTPException(status_code=404, detail="Vehicle not found")
+    return v
+
+
+def _ensure_reg_unique(db: Session, reg: str, exclude_id: int | None = None):
+    q = db.query(models.TransporterVehicle).filter(models.TransporterVehicle.registration_number == reg)
+    if exclude_id is not None:
+        q = q.filter(models.TransporterVehicle.id != exclude_id)
+    if q.first():
+        raise HTTPException(status_code=409, detail="A vehicle with this registration number is already registered")
+
+
+@router.post("/vehicles", response_model=schemas.TransporterVehicleOut, status_code=201)
+def add_vehicle(
+    payload: schemas.TransporterVehicleCreate,
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    data = payload.model_dump(mode="json")
+    data["registration_number"] = _normalize_reg(payload.registration_number)
+    _ensure_reg_unique(db, data["registration_number"])
+    vehicle = models.TransporterVehicle(transporter_id=transporter.id, **data)
+    db.add(vehicle)
+    db.commit()
+    db.refresh(vehicle)
+    return vehicle
+
+
+@router.get("/vehicles", response_model=list[schemas.TransporterVehicleOut])
+def list_my_vehicles(
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    return (
+        db.query(models.TransporterVehicle)
+        .filter(models.TransporterVehicle.transporter_id == transporter.id)
+        .order_by(models.TransporterVehicle.id)
+        .all()
+    )
+
+
+@router.get("/vehicles/{vehicle_id}", response_model=schemas.TransporterVehicleOut)
+def get_my_vehicle(
+    vehicle_id: int,
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    return _own_vehicle_or_404(db, transporter, vehicle_id)
+
+
+@router.patch("/vehicles/{vehicle_id}", response_model=schemas.TransporterVehicleOut)
+def update_vehicle(
+    vehicle_id: int,
+    payload: schemas.TransporterVehicleUpdate,
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    vehicle = _own_vehicle_or_404(db, transporter, vehicle_id)
+    changes = payload.model_dump(mode="json", exclude_unset=True)
+    if "registration_number" in changes:
+        changes["registration_number"] = _normalize_reg(changes["registration_number"])
+        _ensure_reg_unique(db, changes["registration_number"], exclude_id=vehicle.id)
+    # Non-nullable columns: a client sending null for them is ignored rather
+    # than writing NULL.
+    for non_null in ("vehicle_name", "registration_number", "category", "max_capacity_kg",
+                     "available_capacity_kg", "body_type", "is_available", "accepts_farmpool",
+                     "max_detour_km", "max_additional_stops"):
+        if non_null in changes and changes[non_null] is None:
+            del changes[non_null]
+    max_cap = changes.get("max_capacity_kg", vehicle.max_capacity_kg)
+    avail = changes.get("available_capacity_kg", vehicle.available_capacity_kg)
+    if avail > max_cap:
+        raise HTTPException(status_code=422, detail="available_capacity_kg cannot exceed max_capacity_kg")
+    for key, value in changes.items():
+        setattr(vehicle, key, value)
+    db.commit()
+    db.refresh(vehicle)
+    return vehicle
+
+
+@router.delete("/vehicles/{vehicle_id}", status_code=204)
+def delete_vehicle(
+    vehicle_id: int,
+    transporter: models.Transporter = Depends(require_transporter),
+    db: Session = Depends(get_db),
+):
+    vehicle = _own_vehicle_or_404(db, transporter, vehicle_id)
+    db.delete(vehicle)
+    db.commit()
+
+
