@@ -0,0 +1,173 @@
+"""
+Tests for transporter partner onboarding + vehicle management
+(app/routers/transporters.py: PUT /transporter/onboarding, /transporter/vehicles).
+
+Run: pytest backend/tests/test_transporter_onboarding.py -v
+"""
+import os
+import sys
+
+import pytest
+from fastapi import HTTPException
+from pydantic import ValidationError
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from app import models, schemas
+from app.database import Base
+from app.routers import transporters as tr
+
+
+@pytest.fixture()
+def db():
+    engine = create_engine("sqlite:///:memory:", connect_args={"check_same_thread": False})
+    Base.metadata.create_all(bind=engine)
+    session = sessionmaker(bind=engine)()
+    yield session
+    session.close()
+
+
+def _transporter(db, email="t1@example.com"):
+    t = models.Transporter(name="T", email=email, password_hash="x")
+    db.add(t)
+    db.commit()
+    db.refresh(t)
+    return t
+
+
+def _onboarding(**over):
+    data = dict(
+        business_name="Chhattisgarh Carriers", primary_phone="9000000001",
+        operating_district="Bilaspur", operating_state="Chhattisgarh",
+        service_routes=["Bilaspur-Raipur"],
+    )
+    data.update(over)
+    return schemas.TransporterOnboarding(**data)
+
+
+def _vehicle(**over):
+    data = dict(
+        vehicle_name="Tata Ace", registration_number="cg 10 ab 1234", category="MINI_TRUCK",
+        max_capacity_kg=1000, available_capacity_kg=800, body_type="COVERED",
+    )
+    data.update(over)
+    return schemas.TransporterVehicleCreate(**data)
+
+
+# ---- onboarding -------------------------------------------------------------
+
+def test_onboarding_sets_fields_and_stays_pending(db):
+    t = _transporter(db)
+    out = tr.complete_onboarding(_onboarding(whatsapp_number="9000000002"), t, db)
+    assert out.business_name == "Chhattisgarh Carriers"
+    assert out.primary_phone == "9000000001" and out.phone == "9000000001"
+    assert out.whatsapp_number == "9000000002"
+    assert out.service_routes == ["Bilaspur-Raipur"]
+    assert out.preferred_language == "hi"
+    assert out.verification_status == "PENDING"
+
+
+def test_onboarding_required_fields_enforced():
+    for missing in ("business_name", "primary_phone", "operating_district", "operating_state"):
+        with pytest.raises(ValidationError):
+            _onboarding(**{missing: ""})
+    with pytest.raises(ValidationError):
+        _onboarding(service_routes=[])
+
+
+def test_onboarding_cannot_self_verify(db):
+    t = _transporter(db)
+    payload = schemas.TransporterOnboarding(
+        **_onboarding().model_dump(), **{"verification_status": "VERIFIED"}
+    )  # extra key is ignored by the schema
+    out = tr.complete_onboarding(payload, t, db)
+    assert out.verification_status == "PENDING"
+
+
+def test_changing_documents_resets_verification(db):
+    t = _transporter(db)
+    tr.complete_onboarding(_onboarding(verification_documents=["doc-a"]), t, db)
+    t.verification_status = "VERIFIED"
+    db.commit()
+    tr.complete_onboarding(_onboarding(verification_documents=["doc-a"]), t, db)
+    assert t.verification_status == "VERIFIED"  # unchanged docs keep status
+    tr.complete_onboarding(_onboarding(verification_documents=["doc-b"]), t, db)
+    assert t.verification_status == "PENDING"
+
+
+# ---- vehicles ---------------------------------------------------------------
+
+def test_add_vehicle_defaults_and_normalised_registration(db):
+    t = _transporter(db)
+    v = tr.add_vehicle(_vehicle(), t, db)
+    assert v.registration_number == "CG10AB1234"
+    assert v.is_available is True and v.accepts_farmpool is True
+    assert v.max_detour_km == 10.0 and v.max_additional_stops == 2
+
+
+def test_vehicle_validation():
+    with pytest.raises(ValidationError):
+        _vehicle(category="BIKE")
+    with pytest.raises(ValidationError):
+        _vehicle(available_capacity_kg=2000)  # > max
+    with pytest.raises(ValidationError):
+        _vehicle(features=["WIFI"])
+    with pytest.raises(ValidationError):
+        _vehicle(max_capacity_kg=0)
+
+
+def test_duplicate_registration_rejected_across_transporters(db):
+    t1, t2 = _transporter(db), _transporter(db, "t2@example.com")
+    tr.add_vehicle(_vehicle(), t1, db)
+    with pytest.raises(HTTPException) as e:
+        tr.add_vehicle(_vehicle(registration_number="CG10AB1234"), t2, db)
+    assert e.value.status_code == 409
+
+
+def test_empty_return_route_round_trips(db):
+    t = _transporter(db)
+    v = tr.add_vehicle(
+        _vehicle(empty_return_route={"origin": "Raipur", "destination": "Bilaspur", "available_date": "2026-12-01"}),
+        t, db,
+    )
+    assert v.empty_return_route == {"origin": "Raipur", "destination": "Bilaspur", "available_date": "2026-12-01"}
+
+
+def test_vehicles_are_owner_scoped(db):
+    t1, t2 = _transporter(db), _transporter(db, "t2@example.com")
+    v = tr.add_vehicle(_vehicle(), t1, db)
+    assert [x.id for x in tr.list_my_vehicles(t1, db)] == [v.id]
+    assert tr.list_my_vehicles(t2, db) == []
+    for call in (
+        lambda: tr.get_my_vehicle(v.id, t2, db),
+        lambda: tr.update_vehicle(v.id, schemas.TransporterVehicleUpdate(is_available=False), t2, db),
+        lambda: tr.delete_vehicle(v.id, t2, db),
+    ):
+        with pytest.raises(HTTPException) as e:
+            call()
+        assert e.value.status_code == 404
+
+
+def test_partial_update_and_capacity_guard(db):
+    t = _transporter(db)
+    v = tr.add_vehicle(_vehicle(), t, db)
+    out = tr.update_vehicle(v.id, schemas.TransporterVehicleUpdate(is_available=False, rate_per_km=12.5), t, db)
+    assert out.is_available is False and out.rate_per_km == 12.5 and out.vehicle_name == "Tata Ace"
+    with pytest.raises(HTTPException) as e:
+        tr.update_vehicle(v.id, schemas.TransporterVehicleUpdate(max_capacity_kg=500), t, db)  # avail 800 > 500
